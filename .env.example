# Environment Variables Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Gmail Watcher Configuration
# ===========================================
# OAuth2 credentials file path (download from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_FILE=./gmail_credentials.json

# Polling interval in seconds (default: 60)
GMAIL_POLL_INTERVAL=60

# ===========================================
# SMTP/Email Configuration
# ===========================================
# SMTP server settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Default from address
SMTP_FROM=your_email@gmail.com

# ===========================================
# Claude API Configuration
# ===========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Planning mode: "once" (single run) or "continuous" (loop)
PLANNING_MODE=continuous

# Planning interval in seconds (continuous mode)
PLANNING_INTERVAL=300

# ===========================================
# Filesystem Watcher Configuration
# ===========================================
# Comma-separated list of directories to watch
WATCHED_DIRS=./watched

# ===========================================
# Scheduler Configuration
# ===========================================
# Task intervals in seconds (set to 0 to disable)
SCHEDULER_INTERVAL_GMAIL_CHECK=60
SCHEDULER_INTERVAL_FILESYSTEM_CHECK=30
SCHEDULER_INTERVAL_GENERATE_PLANS=300
SCHEDULER_INTERVAL_APPROVAL_CHECK=120
SCHEDULER_INTERVAL_CLEANUP_LOGS=3600
SCHEDULER_INTERVAL_HEALTH_CHECK=600

# ===========================================
# Vault Configuration
# ===========================================
# Base path for AI Employee Vault (default: ./AI_Employee_Vault)
VAULT_BASE_PATH=./AI_Employee_Vault

# ===========================================
# Application Configuration
# ===========================================
# Next.js application port
NEXT_PUBLIC_PORT=3000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===========================================
# Optional: MCP Configuration
# ===========================================
# Enable/disable specific MCP servers
ENABLE_EMAIL_MCP=true
